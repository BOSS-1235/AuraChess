# Copy to .env and fill in. NEVER commit .env — it is already in .gitignore.

# --- AI coach (server-side only; the browser never sees these) ---
# gemini-2.5-* retires 16 Oct 2026 — gemini-3.1-pro-preview is the current
# non-deprecated Pro-tier model. It's slower than a flash model; switch to
# gemini-3-flash-preview here if the live in-game coach feels sluggish.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
# Optional second provider (enables Groq/Llama in the coach + Study page).
# llama-3.3-70b-versatile was decommissioned by Groq on 16 Aug 2026 — using
# it will 404. openai/gpt-oss-120b is Groq's current free-tier default.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Password-reset emails (any SMTP: Gmail app password, Brevo, Resend, Mailgun, SES...) ---
# Leave SMTP_HOST empty in development: reset codes print in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AuraChess <no-reply@yourdomain.com>

# --- Production ---
# Comma-separated list of the exact origins your site is served from (needed for biometric sign-in + CSRF checks)
APP_ORIGINS=https://your-domain.com
# Any long random string, used to hash reset codes
OTP_SECRET=
# Where the SQLite file lives. On hosts with ephemeral disks, point this at a persistent volume.
DB_PATH=data/aurachess.db
PORT=8787
